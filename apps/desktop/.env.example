# Code signing
# Get the exact value with: security find-identity -v -p codesigning
ELECTROBUN_DEVELOPER_ID="Developer ID Application: Teh Zi Gyn (YOUR_TEAM_ID_HERE)"

# Notarization - Option A: App Store Connect API key (recommended)
# Get these at appstoreconnect.apple.com -> Users and Access -> Integrations -> API Keys -> "+"
# ELECTROBUN_APPLEAPIISSUER="UUID from the API key page (also in the downloaded .p8 filename)"
# ELECTROBUN_APPLEAPIKEY="8-char key ID from the API key page"
# ELECTROBUN_APPLEAPIKEYPATH="/path/to/AuthKey_XXXXXXXXXX.p8"

# Notarization - Option B: Apple ID + app-specific password
# App-specific password: appleid.apple.com -> Sign-In and Security -> App-Specific Passwords
# ELECTROBUN_APPLEID="you@example.com"
# ELECTROBUN_APPLEIDPASS="xxxx-xxxx-xxxx-xxxx"
# ELECTROBUN_TEAMID="Your Team ID (developer.apple.com -> Membership)"
